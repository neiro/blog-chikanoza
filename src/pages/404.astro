---
import Layout from '~/layouts/PageLayout.astro';
import { getDictionary, getLocaleFromUrl, getLocaleHomePermalink } from '~/i18n';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDictionary(locale);
const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">{dict.notFound.title}</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">{dict.notFound.back}</p>
        <a rel="noopener noreferrer" href={getLocaleHomePermalink(locale)} class="btn ml-4">
          {dict.notFound.back}
        </a>
      </div>
    </div>
  </section>
</Layout>
