---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getDictionary, getLocaleFromUrl } from '~/i18n';
import nightCity from '~/assets/gallery/27-11-2025/photo_1_2026-01-24_21-35-30.jpg';
import cityDay from '~/assets/gallery/27-11-2025/photo_5_2026-01-24_21-35-30.jpg';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDictionary(locale);
const metadata = {
  title: dict.aboutPage.metadataTitle,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline={dict.aboutPage.tagline}
    image={{
      src: nightCity,
      alt: locale === 'ru' ? 'Ночной город' : 'Night city',
    }}
  >
    <Fragment slot="title">
      <span set:html={dict.aboutPage.title} />
    </Fragment>

    <Fragment slot="subtitle">
      <span set:html={dict.aboutPage.subtitle} />
    </Fragment>
  </Hero>

  <!-- Features3 Widget ************** -->

  <Features3
    title={dict.aboutPage.workTitle}
    subtitle={dict.aboutPage.workSubtitle}
    columns={3}
    isBeforeContent={true}
    items={dict.aboutPage.workItems}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={dict.aboutPage.focusItems}
    image={{
      src: cityDay,
      alt: locale === 'ru' ? 'Город днём' : 'City in daylight',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title={dict.aboutPage.howTitle}
    subtitle={dict.aboutPage.howSubtitle}
    items={[
      {
        title: dict.aboutPage.howItems[0].title,
        description: dict.aboutPage.howItems[0].description,
      },
      {
        title: dict.aboutPage.howItems[1].title,
        description: dict.aboutPage.howItems[1].description,
      },
      {
        title: dict.aboutPage.howItems[2].title,
        description: dict.aboutPage.howItems[2].description,
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title={dict.aboutPage.lifeTitle}
    subtitle={dict.aboutPage.lifeSubtitle}
    isReversed={true}
    items={dict.aboutPage.lifeItems}
  />
</Layout>
