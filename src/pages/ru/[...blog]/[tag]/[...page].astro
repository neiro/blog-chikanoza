---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, getStaticPathsBlogTag } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { getDictionary } from '~/i18n';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props as Props;
const locale = 'ru';
const dict = getDictionary(locale);

const currentPage = page.currentPage ?? 1;
const langParam = Astro.url.searchParams.get('lang') ?? 'all';
const query = langParam && langParam !== 'all' ? `?lang=${langParam}` : '';
const filterLinks = [
  { label: dict.blog.filterAll, value: 'all', href: `${Astro.url.pathname}` },
  { label: dict.blog.filterRu, value: 'ru', href: `${Astro.url.pathname}?lang=ru` },
  { label: dict.blog.filterEn, value: 'en', href: `${Astro.url.pathname}?lang=en` },
];

const metadata = {
  title: `${dict.blog.listTitle} — ${tag.title}${currentPage > 1 ? ` — ${dict.blog.pageLabel} ${currentPage}` : ''}`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>{tag.title}</Headline>
    <div class="flex items-center justify-center gap-3 mb-8 text-sm">
      {
        filterLinks.map((link) => (
          <a
            href={link.href}
            data-lang-filter={link.value}
            class="filter-link px-3 py-1 rounded-full border border-gray-200 dark:border-slate-700 text-muted dark:text-slate-400"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <p
      id="lang-empty"
      class="hidden mb-10 text-center text-sm text-muted dark:text-slate-400"
      aria-live="polite"
    >
      {dict.blog.filterEmpty}
    </p>
    <BlogList posts={page.data} locale={locale} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} locale={locale} query={query} />
  </section>
</Layout>

<script is:inline>
  const ACTIVE_CLASSES = ['text-primary', 'border-primary', 'dark:text-white', 'dark:border-slate-500'];
  const INACTIVE_CLASSES = ['text-muted', 'dark:text-slate-400'];

  const applyLangFilter = () => {
    const params = new URL(window.location.href).searchParams;
    const lang = params.get('lang') || 'all';
    const nodes = document.querySelectorAll('[data-lang]');
    if (lang === 'all') {
      nodes.forEach((el) => {
        el.style.display = '';
      });
    } else {
      nodes.forEach((el) => {
        el.style.display = el.dataset.lang === lang ? '' : 'none';
      });
    }

    document.querySelectorAll('[data-lang-filter]').forEach((el) => {
      const isActive = el.dataset.langFilter === lang;
      ACTIVE_CLASSES.forEach((cls) => el.classList.toggle(cls, isActive));
      INACTIVE_CLASSES.forEach((cls) => el.classList.toggle(cls, !isActive));
      if (isActive) {
        el.setAttribute('aria-current', 'page');
      } else {
        el.removeAttribute('aria-current');
      }
    });

    const emptyState = document.getElementById('lang-empty');
    if (!emptyState) return;
    const visibleCount = Array.from(nodes).filter((el) => el.style.display !== 'none').length;
    emptyState.classList.toggle('hidden', visibleCount > 0);
  };

  applyLangFilter();
  document.addEventListener('astro:page-load', applyLangFilter);
  document.addEventListener('astro:after-swap', applyLangFilter);
</script>
