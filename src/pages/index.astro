---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { localizeUrl, getDictionary, getLocaleFromUrl } from '~/i18n';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDictionary(locale);
const metadataLocalized = {
  title: dict.home.metadataTitle,
};
---

<Layout metadata={metadataLocalized}>
  <Fragment slot="announcement"></Fragment>

  <Fragment slot="header">
    <Header
      links={[
        { text: dict.nav.home, href: '#hero' },
        { text: dict.nav.about, href: '#about' },
        { text: dict.nav.blog, href: '#blog' },
      ]}
      actions={[{ text: dict.nav.contact, href: '#contact' }]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero -->

  <Hero
    id="hero"
    title={dict.hero.title}
    tagline={dict.hero.tagline}
    actions={[{ variant: 'primary', text: dict.hero.cta, href: localizeUrl('/contact#form', locale) }]}
  >
    <Fragment slot="subtitle">
      <span set:html={dict.hero.subtitle} />
    </Fragment>
  </Hero>

  <!-- About -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:server',
        callToAction: {
          target: '_blank',
          text: dict.home.about.items.lab,
          href: '#portfolio',
        },
      },
      {
        icon: 'tabler:world',
        callToAction: {
          target: '_blank',
          text: dict.home.about.items.travel,
          href: '#blog',
        },
      },
      {
        icon: 'tabler:heart',
        callToAction: {
          target: '_blank',
          text: dict.home.about.items.family,
          href: '#about',
        },
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518770660439-4636190af475',
      alt: 'Workspace',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        {dict.home.about.title}
      </h2>

      {
        dict.home.about.paragraphs.map((paragraph) => (
          <>
            <p set:html={paragraph} />
            <br />
          </>
        ))
      }
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Experience -->

  <Steps
    id="resume"
    title={dict.home.experience.title}
    items={[
      {
        title: dict.home.experience.itemTitle,
        description: dict.home.experience.description,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Skills -->

  <Features3
    title={dict.home.skills.title}
    subtitle={dict.home.skills.subtitle}
    columns={3}
    defaultIcon="tabler:point-filled"
    items={dict.home.skills.items}
  />

  <!-- Portfolio -->

  <Content
    id="portfolio"
    title={dict.home.portfolio.title}
    subtitle={dict.home.portfolio.subtitle}
    isReversed
    items={[
      {
        title: dict.home.portfolio.item1Title,
        description: dict.home.portfolio.item1Desc,
      },
      {
        title: dict.home.portfolio.item2Title,
        description: dict.home.portfolio.item2Desc,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1555949963-aa79dcee981c',
      alt: 'Backend architecture',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        {dict.home.portfolio.heading}
      </h3>
      <p class="text-muted">
        {dict.home.portfolio.caption}
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CTA -->

  <CallToAction
    title={dict.home.cta.title}
    subtitle={dict.home.cta.subtitle}
    actions={[{ variant: 'primary', text: dict.home.cta.action, href: '#contact' }]}
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title={dict.home.blog.title}
    information={dict.home.blog.info}
    linkText={dict.blog.viewAll}
    locale={locale}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
