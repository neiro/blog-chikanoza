---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';
import { contentDefaultLocale } from '~/i18n';

export interface Props {
  posts: Array<Post>;
  locale?: import('~/i18n').Locale;
}

const { posts, locale } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li class="mb-12 md:mb-20" data-lang={post.lang ?? contentDefaultLocale}>
        <Item post={post} locale={locale} />
      </li>
    ))
  }
</ul>
