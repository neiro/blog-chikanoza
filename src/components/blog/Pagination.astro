---
import { Icon } from 'astro-icon/components';
import { localizePath, stripLocaleFromPath, type Locale, t } from '~/i18n';
import Button from '~/components/ui/Button.astro';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
  locale?: Locale;
  query?: string;
}

const { prevUrl, nextUrl, prevText, nextText, locale, query = '' } = Astro.props;
const prevLabel = prevText ?? t('blog.newer', locale ?? 'en');
const nextLabel = nextText ?? t('blog.older', locale ?? 'en');
---

{
  (prevUrl || nextUrl) && (
    <div class="container flex">
      <div class="flex flex-row mx-auto container justify-between">
        <Button
          variant="tertiary"
          class={`md:px-3 px-3 mr-2 ${!prevUrl ? 'invisible' : ''}`}
          href={prevUrl ? `${localizePath(stripLocaleFromPath(prevUrl), locale ?? 'en')}${query}` : '#'}
        >
          <Icon name="tabler:chevron-left" class="w-6 h-6" />
          <p class="ml-2">{prevLabel}</p>
        </Button>

        <Button
          variant="tertiary"
          class={`md:px-3 px-3 ${!nextUrl ? 'invisible' : ''}`}
          href={nextUrl ? `${localizePath(stripLocaleFromPath(nextUrl), locale ?? 'en')}${query}` : '#'}
        >
          <span class="mr-2">{nextLabel}</span>
          <Icon name="tabler:chevron-right" class="w-6 h-6" />
        </Button>
      </div>
    </div>
  )
}
