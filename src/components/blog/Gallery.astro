---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

export interface Props {
  folder: string;
  base?: string;
  columns?: 2 | 3 | 4;
  lightbox?: boolean;
  className?: string;
}

const { folder, columns = 3, lightbox = true, className = '', base = 'gallery' } = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const folderPrefix = `/src/assets/${base}/${folder}/`;
const images = Object.entries(modules)
  .filter(([path]) => path.startsWith(folderPrefix))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split('/').pop() ?? '';
    const alt = filename.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ');
    return { src: mod.default, alt, path };
  });

if (!folder || images.length === 0) {
  return null;
}

const galleryId = `gallery-${folder.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const gridClass =
  columns === 2
    ? 'sm:grid-cols-2'
    : columns === 4
      ? 'sm:grid-cols-2 lg:grid-cols-4'
      : 'sm:grid-cols-2 lg:grid-cols-3';
---

<div class={`grid gap-3 ${gridClass} ${className}`}>
  {
    images.map((image) => (
      <button
        type="button"
        class="group relative overflow-hidden rounded-lg bg-gray-100 dark:bg-slate-800"
        data-gallery-item={galleryId}
        data-src={image.src.src}
        data-alt={image.alt}
      >
        <Image
          src={image.src}
          alt={image.alt}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          class="w-full h-full object-cover transition duration-300 group-hover:scale-[1.02]"
          loading="lazy"
          decoding="async"
        />
      </button>
    ))
  }
</div>

{
  lightbox && (
    <>
      <dialog
        data-gallery-dialog={galleryId}
        class="backdrop:bg-black/60 bg-transparent p-0 max-w-5xl w-[90vw] max-h-[90vh] overflow-hidden"
      >
        <div class="relative flex items-center justify-center max-h-[90vh]">
          <button
            type="button"
            data-gallery-prev={galleryId}
            class="absolute left-2 text-white/80 hover:text-white px-3 py-2 text-3xl"
            aria-label="Previous image"
          >
            ‹
          </button>
          <button
            type="button"
            data-gallery-next={galleryId}
            class="absolute right-2 text-white/80 hover:text-white px-3 py-2 text-3xl"
            aria-label="Next image"
          >
            ›
          </button>
          <button
            type="button"
            data-gallery-close={galleryId}
            class="absolute -top-10 right-0 text-white text-sm"
          >
            Close
          </button>
          <img data-gallery-img={galleryId} class="w-full max-h-[85vh] object-contain rounded-lg" alt="" />
        </div>
      </dialog>
      <script is:inline define:vars={{ galleryId }}>
        (() => {
          const dialog = document.querySelector(`dialog[data-gallery-dialog="${galleryId}"]`);
          if (!dialog) return;
          const img = dialog.querySelector(`img[data-gallery-img="${galleryId}"]`);
          const closeBtn = dialog.querySelector(`[data-gallery-close="${galleryId}"]`);
          const prevBtn = dialog.querySelector(`[data-gallery-prev="${galleryId}"]`);
          const nextBtn = dialog.querySelector(`[data-gallery-next="${galleryId}"]`);
          const items = Array.from(document.querySelectorAll(`[data-gallery-item="${galleryId}"]`));
          let currentIndex = 0;

          const showAt = (index) => {
            if (!img || items.length === 0) return;
            currentIndex = (index + items.length) % items.length;
            const item = items[currentIndex];
            const src = item.getAttribute('data-src');
            const alt = item.getAttribute('data-alt') || '';
            if (src) {
              img.setAttribute('src', src);
              img.setAttribute('alt', alt);
            }
          };

          items.forEach((item, index) => {
            item.addEventListener('click', () => {
              showAt(index);
              dialog.showModal();
            });
          });

          prevBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            showAt(currentIndex - 1);
          });
          nextBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            showAt(currentIndex + 1);
          });
          closeBtn?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
          dialog.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') showAt(currentIndex - 1);
            if (event.key === 'ArrowRight') showAt(currentIndex + 1);
          });
        })();
      </script>
    </>
  )
}
