---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { getHeaderData, getFooterData } from '~/navigation';
import { getLocaleFromUrl, getLocaleSwitchLinks } from '~/i18n';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  languageLinks?: Array<{ text: string; href: string; isActive?: boolean; ariaLabel?: string }>;
}

const { metadata, languageLinks: languageLinksProp } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const headerData = getHeaderData(locale);
const footerData = getFooterData(locale);
const languageLinks = languageLinksProp ?? getLocaleSwitchLinks(Astro.url);
---

<Layout metadata={metadata} locale={locale}>
  <slot name="header">
    <Header {...headerData} languageLinks={languageLinks} isSticky showRssFeed showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
